# HARS long-term memory environment — copy to .env and fill in secrets.
# ALL model bindings live here; swap any model with a config edit + reindex.

# ---------------------------------------------------------------------------
# LLM — Extractor (GPU-exclusive, Qwen3.6-27B GGUF via llama.cpp llama-server)
# ---------------------------------------------------------------------------
HARS_MEMORY_EXTRACTOR_BASE_URL=http://localhost:8080/v1
HARS_MEMORY_EXTRACTOR_MODEL=Qwen3.6-27B-Q4_K_M
HARS_MEMORY_LLM_TIMEOUT_SECONDS=8
# Chunking — LightRAG is the sole chunker (index.py passes whole docs).
# HARS_MEMORY_CHUNK_TOKEN_SIZE controls max tokens per chunk (default 512).
# HARS_MEMORY_CHUNK_OVERLAP_TOKENS controls overlap between chunks (default 64).
# HARS_MEMORY_LLM_MAX_TOKEN_SIZE caps the extraction-prompt input fed to the LLM.
# INVARIANT: HARS_MEMORY_LLM_MAX_TOKEN_SIZE ≤ llama-server per-slot context.
#   Per-slot context = -c / --parallel.  With -c 65536 --parallel 2 → 32768/slot.
#   Default 30720 leaves ~2 KB headroom for the system prompt.
HARS_MEMORY_CHUNK_TOKEN_SIZE=512
HARS_MEMORY_CHUNK_OVERLAP_TOKENS=64
HARS_MEMORY_LLM_MAX_TOKEN_SIZE=30720
# Max output tokens the extractor LLM may generate per chunk.  Dense 1024-token
# chunks need more than 4096 to emit all entities+relations+descriptions + the
# mandatory <|COMPLETE|> delimiter.  MUST be ≤ server per-slot context minus input overhead.
# With -c 65536 --parallel 2 → 32768/slot; input 1024 + prompt ~1600 → 8192 output is safe.
HARS_MEMORY_EXTRACTOR_MAX_TOKENS=8192
# Start the extractor server with enough context to avoid truncation:
#   ROCR_VISIBLE_DEVICES=0 llama-server \
#     -m /mnt/datasets/models/.hf_home/hub/models--unsloth--Qwen3.6-27B-GGUF/snapshots/.../Qwen3.6-27B-Q4_K_M.gguf \
#     --alias Qwen3.6-27B-Q4_K_M --host 127.0.0.1 --port 8080 --n-gpu-layers 99 \
#     -c 65536 --parallel 2 --jinja --reasoning off

# ---------------------------------------------------------------------------
# LLM — Query / keyword (light, can run on CPU with a small model)
# ---------------------------------------------------------------------------
HARS_MEMORY_QUERY_BASE_URL=http://localhost:8081/v1
HARS_MEMORY_QUERY_MODEL=Qwen3.5-4B-Q4_K_M
HARS_MEMORY_QUERY_TIMEOUT_SECONDS=60
# Start with: llama-server -m /mnt/datasets/models/Qwen3.5-4B-Q4_K_M.gguf \
#   --port 8081 --n-gpu-layers 0 --ctx-size 4096

# ---------------------------------------------------------------------------
# Embedder — CPU-only, e5-large-v2 from HF cache
# ---------------------------------------------------------------------------
HARS_MEMORY_EMBED_MODEL=intfloat/e5-large-v2
# To swap: set to bge-m3, nomic-embed-text, etc. — this changes the vector
# dimension, so reindex with --full after switching: memory-index --full
HARS_MEMORY_EMBED_LOCAL_FILES_ONLY=1

HF_HOME=/mnt/datasets/models/.hf_home

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
HARS_MEMORY_VECTOR_STORAGE=QdrantVectorDBStorage
HARS_MEMORY_GRAPH_STORAGE=NetworkXStorage

# Dedicated long-term memory Qdrant compose service (hars-memory-qdrant,
# volume memory_qdrant_storage) is exposed on host port 6335. Vector storage
# migrated from NanoVectorDBStorage to QdrantVectorDBStorage 2026-07-30 (zero
# re-embedding transplant; see .plans/2026-07-29_graphrag-qdrant-migration.md
# and .session/2026-07-30_qdrant-migration-execution.md). Rollback: set this
# back to NanoVectorDBStorage AND restore vdb_*.json — see the session doc.
# NOTE: HARS_MEMORY_QDRANT_COLLECTION is NOT a Qdrant collection name — LightRAG
# exports it as QDRANT_WORKSPACE and uses it as the tenant id written into every
# payload's workspace_id and every query filter. The real collection names are
# fixed to exactly lightrag_vdb_{chunks,entities,relationships} (no model_suffix,
# since EmbeddingFunc carries no model_name at this call site).
HARS_MEMORY_QDRANT_URL=http://localhost:6335
HARS_MEMORY_QDRANT_COLLECTION=hars_longterm_memory

# ---------------------------------------------------------------------------
# NetworkX / LightRAG working dirs — REQUIRED, no machine-specific default.
# This package does not assume any particular filesystem layout; both must
# be set explicitly or the server refuses to start.
# ---------------------------------------------------------------------------
HARS_MEMORY_INDEX_DIR=/tmp/hars_memory_lightrag
HARS_MEMORY_STAGING_DIR=/tmp/hars_memory_staging
# HARS_MEMORY_BM25_CACHE_DIR is NOT set here on purpose — it derives from
# HARS_MEMORY_INDEX_DIR (a sibling `bm25_cache/` dir) unless overridden.

# Postgres export is NOT part of this package — it is entirely the consuming
# project's own responsibility, via its own script calling this package's
# public hars_memory.ingest.api.ingest_documents() directly.

# ---------------------------------------------------------------------------
# GPU concurrency guard — OPTIONAL, entirely the consuming project's concern.
# Unset (default): memory_consolidate performs no GPU-concurrency check at
# all and proceeds unconditionally. Set to a Python file exposing
# assert_gpu_free(api_base_url) to enable one (called before every
# non-dry-run memory_consolidate, and by cortex-scripts/update_kb.sh before
# starting the extractor server).
# HARS_MEMORY_GPU_GUARD_SCRIPT_PATH=/path/to/gpu_guard.py
# HARS backend used by that guard script to query running experiments:
HARS_API_BASE_URL=http://localhost:8765
# gpu_guard fails CLOSED (refuses to index) when this backend is unreachable,
# since an unreachable backend means we cannot confirm the GPU is free.
# Set to 1 ONLY when you know the GPU is idle and the backend is down.
# HARS_MEMORY_GPU_GUARD_ALLOW_UNREACHABLE=1

# ---------------------------------------------------------------------------
# Ripgrep retrieval channel — OPTIONAL, comma-separated absolute search roots.
# Unset (default): the channel reports itself unavailable and is skipped —
# there is no meaningful default search root for an installed package.
# ---------------------------------------------------------------------------
# HARS_MEMORY_RIPGREP_ROOTS=/path/to/your/project

# ---------------------------------------------------------------------------
# Optional extra ingest root — Claude Code project-memory directory
# ---------------------------------------------------------------------------
# ~90 curated .md knowledge files, outside the repo. Unset by default: set
# this to YOUR OWN Claude Code project-memory path to include it in indexing.
# HARS_MEMORY_CLAUDE_MEMORY_DIR=/home/<user>/.claude/projects/<project-slug>/memory

# ---------------------------------------------------------------------------
# Content-change fingerprint sidecar — used only with index.py --refresh-changed
# ---------------------------------------------------------------------------
# Default: <HARS_MEMORY_INDEX_DIR>/doc_fingerprints.json
# HARS_MEMORY_FINGERPRINT_STORE=/tmp/hars_memory_lightrag/doc_fingerprints.json

# ---------------------------------------------------------------------------
# Retrieval tuning — measured 2026-07-29/30 on the 46-query
# tools/memory/eval/retrieval_queries.yaml labeled set (see
# retrieval/fusion.py and hars_longterm_memory_mcp.py for the full tables)
# ---------------------------------------------------------------------------
# Dense/sparse fusion weight (score = alpha*dense + (1-alpha)*sparse).
# Measured empirical optimum on this corpus. Default: 0.5
# HARS_MEMORY_HYBRID_ALPHA=0.5
# Disable the additive dense+BM25 hybrid `hybrid` response field entirely.
# Default: 1 (enabled)
# HARS_MEMORY_HYBRID_ENABLED=1
# memory_recall's `context_priority` server-wide default. Flipped to 'merged'
# 2026-07-30 (recall@1 0.477->0.5324, recall@10 0.727->0.8241 vs the old
# 'lightrag' default, no regressions). Set to 'lightrag' to revert every
# caller that omits context_priority; per-call override always wins
# regardless of this var. Default: merged
# HARS_MEMORY_CONTEXT_PRIORITY_DEFAULT=merged
# Supersession-aware re-ranking (demotes self-declared-deprecated / stale
# documents). Flipped to ON 2026-07-30 (supersession_error_rate 0.333->0.1667,
# no regression on any other metric). Set to 0 to revert to raw fused
# ranking. Default: 1 (enabled)
# HARS_MEMORY_SUPERSESSION_SCORING=1
# Sub-flag: marker-penalty signal (self-declared "DEPRECATED" documents).
# Default ON — the one signal that measured a clean win. Only takes effect
# when HARS_MEMORY_SUPERSESSION_SCORING=1.
# HARS_MEMORY_SUPERSESSION_MARKER_PENALTY=1
# Sub-flag: recency-discount signal. Default OFF and MUST STAY OFF — measured
# harmful: zero supersession fixes, regressed identifier recall@1 0.602->0.560
# reproducibly across 3 seeds. Only takes effect when
# HARS_MEMORY_SUPERSESSION_SCORING=1; do not enable without re-measuring.
# HARS_MEMORY_SUPERSESSION_RECENCY_DISCOUNT=0

# ---------------------------------------------------------------------------
# Optional remote index-job HTTP service + SDK
# ---------------------------------------------------------------------------
# Required when starting `hars-longterm-memory-server`. JSON maps opaque API
# keys to tenant IDs; keep the real value in a secret manager/gitignored env.
HARS_MEMORY_API_KEYS_JSON={"replace-with-a-secret-key":"tenant-a"}

# SQLite for a single local service, PostgreSQL for a cloud/multi-process DB.
HARS_MEMORY_SERVICE_DATABASE_URL=sqlite:///./hars-memory-service.sqlite3
# HARS_MEMORY_SERVICE_DATABASE_URL=postgresql+psycopg://user:password@db/hars_memory

# Immutable input/output artifact store: local filesystem or S3-compatible.
HARS_MEMORY_ARTIFACT_STORE_URL=file:///tmp/hars-memory-artifacts
# HARS_MEMORY_ARTIFACT_STORE_URL=s3://bucket/prefix
# HARS_MEMORY_S3_ENDPOINT_URL=https://s3.example.com
# HARS_MEMORY_S3_REGION=eu-central-1

HARS_MEMORY_SERVICE_HOST=127.0.0.1
HARS_MEMORY_SERVICE_PORT=8787
HARS_MEMORY_WORKER_POLL_SECONDS=1
# HARS_MEMORY_WORKER_SCRATCH_DIR=/tmp/hars-memory-worker

# Upload bounds (defaults shown).
HARS_MEMORY_MAX_UPLOAD_FILES=100
HARS_MEMORY_MAX_UPLOAD_FILE_BYTES=2097152
HARS_MEMORY_MAX_UPLOAD_TOTAL_BYTES=20971520
