# Opt-in only. The live test is skipped unless this is exactly enabled.
HARS_RUN_LIVE_LLM_E2E=1

# OpenAI-compatible extractor used by real LightRAG indexing.
HARS_MEMORY_EXTRACTOR_BASE_URL=https://litellm.labs.jb.gg/v1
HARS_MEMORY_EXTRACTOR_MODEL=openai/gpt-5.6-luna
# gpt-5.6-luna only supports temperature=1.0 (the default); override the
# LightRAG default of 0.1 to avoid a 400 Bad Request.
HARS_MEMORY_EXTRACTOR_TEMPERATURE=1.0

# OpenAI-compatible query model used by the final MCP synthesis check.
HARS_MEMORY_QUERY_BASE_URL=https://litellm.labs.jb.gg/v1
HARS_MEMORY_QUERY_MODEL=openai/gpt-5.6-luna
# gpt-5.6-luna requires temperature=1.0 for the query LLM as well.
HARS_MEMORY_QUERY_TEMPERATURE=1.0

# LiteLLM API key
HARS_MEMORY_LLM_API_KEY=sk-cYbGJRJRHOuTRerUjlDShQ

# The tiny fixture is bounded, but a cold real model can still be slow.
HARS_LIVE_LLM_JOB_TIMEOUT=1200
HARS_MEMORY_LLM_TIMEOUT_SECONDS=300
HARS_MEMORY_LLM_RETRY_ATTEMPTS=2

# Knowledge-source manifest: the maintained list of directories to ingest and
# to search literally. Read by both the indexer (when --paths is omitted) and
# the ripgrep channel (when HARS_MEMORY_RIPGREP_ROOTS is unset).
HARS_MEMORY_SOURCES_MANIFEST=/Users/iurii.medvedev/Work/sre-support-pier/knowledge-sources.yaml

# Local CPU cross-encoder reranker for hybrid candidate reordering
HARS_MEMORY_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HARS_MEMORY_QUERY_FETCH_TOP_K_MULTIPLIER=2.0

# The embedding model is intentionally local/CPU for the portable NanoVectorDB
# artifact used by this E2E. It must already exist in HF_HOME.
HARS_MEMORY_EMBED_MODEL=unsloth/embeddinggemma-300m
# HARS_MEMORY_EMBED_LOCAL_FILES_ONLY=1
HF_HOME=/Users/iurii.medvedev/.cache/huggingface