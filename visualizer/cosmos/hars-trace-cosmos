#!/usr/bin/env python3
"""Standalone read-only cosmos trace server (/stats /graph /coords).

The MCP service's in-process trace listener is bound lazily and may be held by
an older process; this serves the read-only index export the Memory Travel
starfield needs, on its own port, without touching the MCP service.
"""
import asyncio
import os

from hars_memory.trace import start_trace_server


async def _main() -> None:
    host = os.environ.get("HARS_TRACE_HOST", "127.0.0.1")
    port = int(os.environ.get("HARS_TRACE_PORT", "8097"))
    server = await start_trace_server(host, port)
    async with server:
        await server.serve_forever()


if __name__ == "__main__":
    asyncio.run(_main())
