FROM ghcr.io/astral-sh/uv:0.5.9 AS uv

FROM python:3.13-slim

COPY --from=uv /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY hars_memory ./hars_memory

RUN uv sync --frozen --no-dev --extra server --extra s3 \
    && useradd --create-home --uid 10001 hars-memory \
    && mkdir -p /data/artifacts /data/scratch \
    && chown -R hars-memory:hars-memory /data

ENV PATH="/app/.venv/bin:$PATH" \
    HARS_MEMORY_SERVICE_HOST="0.0.0.0" \
    HARS_MEMORY_SERVICE_PORT="8787" \
    HARS_MEMORY_SERVICE_DATABASE_URL="sqlite:////data/jobs.sqlite3" \
    HARS_MEMORY_ARTIFACT_STORE_URL="file:///data/artifacts" \
    HARS_MEMORY_WORKER_SCRATCH_DIR="/data/scratch"

USER hars-memory
EXPOSE 8787
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8787/health', timeout=2)"

CMD ["hars-longterm-memory-server"]
