# HARS long-term memory environment — copy to .env and fill in secrets.
# ALL model bindings live here; swap any model with a config edit + reindex.

# ---------------------------------------------------------------------------
# LLM — Extractor (GPU-exclusive, Qwen3.6-27B GGUF via llama.cpp llama-server)
# ---------------------------------------------------------------------------
HARS_MEMORY_EXTRACTOR_BASE_URL=http://localhost:8080/v1
HARS_MEMORY_EXTRACTOR_MODEL=Qwen3.6-27B-Q4_K_M
HARS_MEMORY_LLM_TIMEOUT_SECONDS=8
# Chunking — LightRAG is the sole chunker (index.py passes whole docs).
# HARS_MEMORY_CHUNK_TOKEN_SIZE controls max tokens per chunk (default 512).
# HARS_MEMORY_CHUNK_OVERLAP_TOKENS controls overlap between chunks (default 64).
# HARS_MEMORY_LLM_MAX_TOKEN_SIZE caps the extraction-prompt input fed to the LLM.
# INVARIANT: HARS_MEMORY_LLM_MAX_TOKEN_SIZE ≤ llama-server per-slot context.
#   Per-slot context = -c / --parallel.  With -c 65536 --parallel 2 → 32768/slot.
#   Default 30720 leaves ~2 KB headroom for the system prompt.
HARS_MEMORY_CHUNK_TOKEN_SIZE=512
HARS_MEMORY_CHUNK_OVERLAP_TOKENS=64
HARS_MEMORY_LLM_MAX_TOKEN_SIZE=30720
# Max output tokens the extractor LLM may generate per chunk.  Dense 1024-token
# chunks need more than 4096 to emit all entities+relations+descriptions + the
# mandatory <|COMPLETE|> delimiter.  MUST be ≤ server per-slot context minus input overhead.
# With -c 65536 --parallel 2 → 32768/slot; input 1024 + prompt ~1600 → 8192 output is safe.
HARS_MEMORY_EXTRACTOR_MAX_TOKENS=8192
# Start the extractor server with enough context to avoid truncation:
#   ROCR_VISIBLE_DEVICES=0 llama-server \
#     -m /mnt/datasets/models/.hf_home/hub/models--unsloth--Qwen3.6-27B-GGUF/snapshots/.../Qwen3.6-27B-Q4_K_M.gguf \
#     --alias Qwen3.6-27B-Q4_K_M --host 127.0.0.1 --port 8080 --n-gpu-layers 99 \
#     -c 65536 --parallel 2 --jinja --reasoning off

# ---------------------------------------------------------------------------
# LLM — Query / keyword (light, can run on CPU with a small model)
# ---------------------------------------------------------------------------
HARS_MEMORY_QUERY_BASE_URL=http://localhost:8081/v1
HARS_MEMORY_QUERY_MODEL=Qwen3.5-4B-Q4_K_M
HARS_MEMORY_QUERY_TIMEOUT_SECONDS=60
# Start with: llama-server -m /mnt/datasets/models/Qwen3.5-4B-Q4_K_M.gguf \
#   --port 8081 --n-gpu-layers 0 --ctx-size 4096

# ---------------------------------------------------------------------------
# Embedder — CPU-only, e5-large-v2 from HF cache
# ---------------------------------------------------------------------------
HARS_MEMORY_EMBED_MODEL=intfloat/e5-large-v2
# To swap: set to bge-m3, nomic-embed-text, etc. — this changes the vector
# dimension, so reindex with --full after switching: memory-index --full
HARS_MEMORY_EMBED_LOCAL_FILES_ONLY=1

HF_HOME=/mnt/datasets/models/.hf_home

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
HARS_MEMORY_VECTOR_STORAGE=NanoVectorDBStorage
HARS_MEMORY_GRAPH_STORAGE=NetworkXStorage

# Dedicated long-term memory Qdrant compose service is exposed on host port 6335.
# The current pinned LightRAG package uses NanoVectorDBStorage by default; set
# HARS_MEMORY_VECTOR_STORAGE to a Qdrant backend only after the installed LightRAG
# build provides one.
HARS_MEMORY_QDRANT_URL=http://localhost:6335
HARS_MEMORY_QDRANT_COLLECTION=hars_longterm_memory

# ---------------------------------------------------------------------------
# NetworkX / LightRAG working dirs
# ---------------------------------------------------------------------------
HARS_MEMORY_INDEX_DIR=/tmp/hars_memory_lightrag
HARS_MEMORY_STORAGE_DIR=/tmp/hars_memory_store

# ---------------------------------------------------------------------------
# Postgres — read-only source export (hars-postgres)
# ---------------------------------------------------------------------------
HARS_MEMORY_POSTGRES_DSN=postgresql://localhost:5432/hars

# ---------------------------------------------------------------------------
# HARS backend — used for GPU concurrency guard
# ---------------------------------------------------------------------------
HARS_API_BASE_URL=http://localhost:8765
# gpu_guard fails CLOSED (refuses to index) when this backend is unreachable,
# since an unreachable backend means we cannot confirm the GPU is free.
# Set to 1 ONLY when you know the GPU is idle and the backend is down.
# HARS_MEMORY_GPU_GUARD_ALLOW_UNREACHABLE=1

# ---------------------------------------------------------------------------
# Optional extra ingest root — Claude Code project-memory directory
# ---------------------------------------------------------------------------
# ~90 curated .md knowledge files, outside the repo. Unset by default: set
# this to YOUR OWN Claude Code project-memory path to include it in indexing.
# HARS_MEMORY_CLAUDE_MEMORY_DIR=/home/<user>/.claude/projects/<project-slug>/memory

# ---------------------------------------------------------------------------
# Content-change fingerprint sidecar — used only with index.py --refresh-changed
# ---------------------------------------------------------------------------
# Default: <HARS_MEMORY_INDEX_DIR>/doc_fingerprints.json
# HARS_MEMORY_FINGERPRINT_STORE=/tmp/hars_memory_lightrag/doc_fingerprints.json
