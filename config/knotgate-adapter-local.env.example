# hars-longterm-memory as a KnotGate agent-adapter MCP server — copy to .env
# and fill in the paths. This deployment mode routes LLM and embedding calls
# through the adapter's own loopback bridges instead of a bare llama-server +
# local sentence-transformers model, so it needs NO local Python ML runtime
# (no torch, no sentence-transformers, no downloaded model weights) and NO
# GPU. It ONLY works against an agent-adapter running in `local` LLM_PROVIDER
# mode — see adapter_mode_guard.py for why, and the ADAPTER_HEALTH_URL guard
# below, which refuses to start otherwise rather than 503-looping silently.

# ---------------------------------------------------------------------------
# Adapter guard — REQUIRED for this deployment mode. Fails closed at startup
# if the adapter is not confirmed to be running in 'local' mode.
# ---------------------------------------------------------------------------
HARS_MEMORY_ADAPTER_HEALTH_URL=http://127.0.0.1:4243/health

# ---------------------------------------------------------------------------
# LLM — extractor and query, both via the adapter's loopback chat-completions
# bridge. Any real chat model the operator has configured for `local` mode
# works — this is not tied to any specific model family (llama.cpp, vLLM,
# Ollama, whatever the colocated Processor is pointed at).
# ---------------------------------------------------------------------------
HARS_MEMORY_EXTRACTOR_BASE_URL=http://127.0.0.1:4243/internal/llm/openai/v1
HARS_MEMORY_EXTRACTOR_MODEL=local/whatever-model-the-adapter-is-configured-for
HARS_MEMORY_QUERY_BASE_URL=http://127.0.0.1:4243/internal/llm/openai/v1
HARS_MEMORY_QUERY_MODEL=local/whatever-model-the-adapter-is-configured-for
# No HARS_MEMORY_LLM_API_KEY needed — the loopback route is unauthenticated
# by network topology (127.0.0.1-only), not by bearer token.

# ---------------------------------------------------------------------------
# Embedder — bridges to the adapter's own EmbeddingProvider instead of a
# local sentence-transformers model. See adapter_embedder.py's module doc.
# ---------------------------------------------------------------------------
HARS_MEMORY_EMBED_BACKEND=adapter
HARS_MEMORY_EMBED_ADAPTER_URL=http://127.0.0.1:4243/internal/embeddings/v1/embeddings
# Matches whatever the adapter's own EMBEDDING_MODEL is configured to (may be
# ignored by the configured EmbeddingProvider — see that env var's own doc).
HARS_MEMORY_EMBED_MODEL=

# ---------------------------------------------------------------------------
# NetworkX / LightRAG working dirs — REQUIRED, no machine-specific default.
# Point this at a directory on the adapter's own persistent volume so the
# index survives a container restart, e.g. under /workspace.
# ---------------------------------------------------------------------------
HARS_MEMORY_INDEX_DIR=/workspace/hars-longterm-memory/index
HARS_MEMORY_STAGING_DIR=/workspace/hars-longterm-memory/staging

# ---------------------------------------------------------------------------
# GPU concurrency guard — leave unset. This deployment never touches a local
# GPU at all (extraction/query/embedding all go through the adapter), so
# there is nothing for a GPU guard to protect here.
# ---------------------------------------------------------------------------
