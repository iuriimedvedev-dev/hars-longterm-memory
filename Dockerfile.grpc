# Universal gRPC sidecar image — no baked index; index comes from PVC / Qdrant.
FROM ghcr.io/astral-sh/uv:0.5.9 AS uv

FROM python:3.13-slim

COPY --from=uv /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY hars_memory ./hars_memory
COPY proto ./proto

RUN uv sync --frozen --no-dev \
    && useradd --create-home --uid 10001 hars-memory \
    && mkdir -p /data/index /data/staging /data/hf /data/bm25_cache /data/flat_dense_cache \
    && chown -R hars-memory:hars-memory /data

ENV PATH="/app/.venv/bin:$PATH" \
    HARS_MEMORY_GRPC_HOST="0.0.0.0" \
    HARS_MEMORY_GRPC_PORT="8788" \
    HARS_MEMORY_INDEX_DIR="/data/index" \
    HARS_MEMORY_STAGING_DIR="/data/staging" \
    HF_HOME="/data/hf" \
    TRANSFORMERS_CACHE="/data/hf"

USER hars-memory
EXPOSE 8788
VOLUME ["/data"]

CMD ["hars-longterm-memory-grpc"]
