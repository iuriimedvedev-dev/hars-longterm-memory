# Opt-in only. The live test is skipped unless this is exactly enabled.
HARS_RUN_LIVE_LLM_E2E=1

# OpenAI-compatible extractor used by real LightRAG indexing.
HARS_MEMORY_EXTRACTOR_BASE_URL=http://127.0.0.1:8080/v1
HARS_MEMORY_EXTRACTOR_MODEL=replace-with-served-extractor-alias

# OpenAI-compatible query model used by the final MCP synthesis check.
HARS_MEMORY_QUERY_BASE_URL=http://127.0.0.1:8081/v1
HARS_MEMORY_QUERY_MODEL=replace-with-served-query-alias

# Optional when the provider requires bearer authentication. Never commit it.
# HARS_MEMORY_LLM_API_KEY=

# The tiny fixture is bounded, but a cold real model can still be slow.
HARS_LIVE_LLM_JOB_TIMEOUT=1200
HARS_MEMORY_LLM_TIMEOUT_SECONDS=300
HARS_MEMORY_LLM_RETRY_ATTEMPTS=2

# The embedding model is intentionally local/CPU for the portable NanoVectorDB
# artifact used by this E2E. It must already exist in HF_HOME.
HARS_MEMORY_EMBED_MODEL=unsloth/embeddinggemma-300m
HARS_MEMORY_EMBED_LOCAL_FILES_ONLY=1
# HF_HOME=/path/to/local/huggingface/cache
