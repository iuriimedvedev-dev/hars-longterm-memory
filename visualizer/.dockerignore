# .dockerignore for memory-travel

# Version control
.git
.gitignore

# Node & Package Managers
node_modules
app/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
dist
app/dist

# Python artifacts
.venv
venv
__pycache__
*.pyc
*.pyo
*.pyd

# Operating system / IDE files
.DS_Store
Thumbs.db
.idea
.vscode
*.swp
*.swo

# Documentation screenshots (large binary assets not required for runtime)
docs/screenshots/

# Environment files with secrets (keep .env.example)
.env
.env.local
.env.*.local

# Temp directories
tmp/
