# Map client Authorization header:
# If client provides an Authorization header, forward it directly.
# If client does not provide an Authorization header, fallback to the configured default token (if any).
map $http_authorization $final_auth {
    "~^.+"   $http_authorization;
    default  "${DEFAULT_AUTH_BEARER}";
}

server {
    listen 8080;
    listen 4400;
    server_name _;
    absolute_redirect off;
    root /usr/share/nginx/html;
    index index.html;

    # Dynamic runtime DNS resolution so Nginx does not fail startup if backend is temporarily unreachable
    resolver ${RESOLVER} valid=10s ipv6=off;

    # -------------------------------------------------------------------------
    # Health check for Kubernetes probes & monitoring
    # -------------------------------------------------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # -------------------------------------------------------------------------
    # Memory MCP Bridge Proxies (Streamable HTTP MCP: tools/call, initialize)
    # -------------------------------------------------------------------------
    location /travel/api/memory {
        set $backend_mem "${BACKEND_MEMORY_URL}";
        rewrite ^/travel/api/memory/?(.*)$ ${BACKEND_MEMORY_PATH}$1 break;
        proxy_pass $backend_mem;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization $final_auth;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location /api/memory {
        set $backend_mem "${BACKEND_MEMORY_URL}";
        rewrite ^/api/memory/?(.*)$ ${BACKEND_MEMORY_PATH}$1 break;
        proxy_pass $backend_mem;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Authorization $final_auth;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # -------------------------------------------------------------------------
    # Live Recall Trace Proxies (SSE stream on port 8098: /trace, /healthz)
    # Buffering MUST be disabled for real-time SSE stage events.
    # -------------------------------------------------------------------------
    location /travel/api/trace {
        set $backend_trace "${BACKEND_TRACE_URL}";
        rewrite ^/travel/api/trace/?(.*)$ /$1 break;
        proxy_pass $backend_trace;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/trace {
        set $backend_trace "${BACKEND_TRACE_URL}";
        rewrite ^/api/trace/?(.*)$ /$1 break;
        proxy_pass $backend_trace;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_cache off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # -------------------------------------------------------------------------
    # Graph & Stats Export Proxies (/stats, /graph, /coords)
    # Read-only cosmos starfield data source served by trace server on port 8098.
    # -------------------------------------------------------------------------
    location /travel/api/graph-stats {
        set $backend_trace "${BACKEND_COSMOS_URL}";
        rewrite ^/travel/api/graph-stats/?(.*)$ /$1 break;
        proxy_pass $backend_trace;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering on;
        proxy_buffers 16 128k;
        proxy_busy_buffers_size 256k;
    }

    location /api/graph-stats {
        set $backend_trace "${BACKEND_COSMOS_URL}";
        rewrite ^/api/graph-stats/?(.*)$ /$1 break;
        proxy_pass $backend_trace;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering on;
        proxy_buffers 16 128k;
        proxy_busy_buffers_size 256k;
    }

    # -------------------------------------------------------------------------
    # Static Assets & SPA Routing
    # Supports both sub-path (/travel/) and root (/) hosting seamlessly.
    # -------------------------------------------------------------------------
    location = /travel {
        return 301 /travel/;
    }

    location /travel/ {
        alias /usr/share/nginx/html/;
        try_files $uri $uri/ /travel/index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
